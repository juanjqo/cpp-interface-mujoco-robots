<!--
  The Unitree B1 quadruped with position actuators: ctrl is the joint position (within the joint
  range), tracked with a stiffness kp and a damping kv, within the torque limits of the joints. The
  "home" keyframe stands. The robot itself is in b1_robot.xml.
-->
<mujoco model="unitree_b1">
  <include file="b1_robot.xml"/>

  <actuator>
    <position name="FL_hip" joint="FL_hip_joint" kp="1000" kv="30" inheritrange="1"/>
    <position name="FL_thigh" joint="FL_thigh_joint" kp="1000" kv="30" inheritrange="1"/>
    <position name="FL_calf" joint="FL_calf_joint" kp="1000" kv="30" inheritrange="1"/>

    <position name="FR_hip" joint="FR_hip_joint" kp="1000" kv="30" inheritrange="1"/>
    <position name="FR_thigh" joint="FR_thigh_joint" kp="1000" kv="30" inheritrange="1"/>
    <position name="FR_calf" joint="FR_calf_joint" kp="1000" kv="30" inheritrange="1"/>

    <position name="RL_hip" joint="RL_hip_joint" kp="1000" kv="30" inheritrange="1"/>
    <position name="RL_thigh" joint="RL_thigh_joint" kp="1000" kv="30" inheritrange="1"/>
    <position name="RL_calf" joint="RL_calf_joint" kp="1000" kv="30" inheritrange="1"/>

    <position name="RR_hip" joint="RR_hip_joint" kp="1000" kv="30" inheritrange="1"/>
    <position name="RR_thigh" joint="RR_thigh_joint" kp="1000" kv="30" inheritrange="1"/>
    <position name="RR_calf" joint="RR_calf_joint" kp="1000" kv="30" inheritrange="1"/>
  </actuator>

  <keyframe>
    <key name="home"
      qpos="0 0 0.615 1 0 0 0
          0 0.7 -1.2
          0 0.7 -1.2
          0 0.7 -1.2
          0 0.7 -1.2"
      ctrl="0 0.7 -1.2
          0 0.7 -1.2
          0 0.7 -1.2
          0 0.7 -1.2"/>
  </keyframe>
</mujoco>
