<!--
  The Unitree Z1 with its gripper, with velocity actuators: ctrl is the joint velocity (within the
  velocity limit of the URDF, 3.1415 rad/s), tracked with a gain kv = 30 (N·m per rad/s), within
  the torque limits of the joints. With zero velocities, the arm sinks slowly under its weight.
  The gripper has a position actuator (ctrl from -1.5, open, to 0, closed), whatever the actuators
  of the arm. The robot itself is in z1_gripper_robot.xml.
-->
<mujoco model="z1">
  <include file="z1_gripper_robot.xml"/>

  <actuator>
    <velocity name="motor1" joint="joint1" kv="30" ctrlrange="-3.1415 3.1415" forcerange="-30 30"/>
    <velocity name="motor2" joint="joint2" kv="30" ctrlrange="-3.1415 3.1415" forcerange="-60 60"/>
    <velocity name="motor3" joint="joint3" kv="30" ctrlrange="-3.1415 3.1415" forcerange="-30 30"/>
    <velocity name="motor4" joint="joint4" kv="30" ctrlrange="-3.1415 3.1415" forcerange="-30 30"/>
    <velocity name="motor5" joint="joint5" kv="30" ctrlrange="-3.1415 3.1415" forcerange="-30 30"/>
    <velocity name="motor6" joint="joint6" kv="30" ctrlrange="-3.1415 3.1415" forcerange="-30 30"/>
    <general class="z1" name="motorGripper" joint="jointGripper" ctrlrange="-1.51844 0"/>
  </actuator>

  <keyframe>
    <key name="home" qpos="0 0.785 -0.261 -0.523 0 0 0" ctrl="0 0 0 0 0 0 0"/>
  </keyframe>
</mujoco>
